const listaColonne={
  alimentazione:["data","alimento","specie_fase","quantita","unita","frequenza","note"],
  anellini:["anno","numero","colore","misura","tipo","soggetto","stato","note"],
  calendario:["data","evento","categoria","coppia_soggetto","stato","note"],
  salute:["soggetto","data","tipo","peso","trattamento","scadenza","note"]
};
const listaTitoli={quantità:"Quantità",unità:"Unità",coppia_soggetto:"Coppia/soggetto",specie_fase:"Specie / fase"};

async function aggiornaLista(tabella,id){
  try{
    const dati=await leggi(tabella),lista=document.getElementById(id);
    if(!dati.length){lista.innerHTML='<div class="card empty">Nessun elemento inserito.</div>';return}
    const cols=listaColonne[tabella]||[];
    lista.innerHTML=dati.map(x=>`<div class="item">${cols.map(k=>`<p><b>${esc(listaTitoli[k]||k)}:</b> ${esc(x[k]??"-")}</p>`).join("")}
      <button class="danger" onclick="eliminaRecord('${tabella}','${x.id}','${tabella}')">Elimina</button></div>`).join("");
  }catch(e){errore(e)}
}

async function eliminaRecord(tabella,id,pagina){
  if(!confirm("Vuoi eliminare questo elemento?"))return;
  try{await elimina(tabella,id);if(pagina==="soggetti")await aggiornaSoggetti();
    else if(pagina==="coppie")await aggiornaCoppie();
    else if(pagina==="riproduzione")await aggiornaRiproduzione();
    else if(pagina==="gabbie")await aggiornaGabbie();
    else if(listaColonne[pagina])await aggiornaLista(pagina,"lista"+pagina.charAt(0).toUpperCase()+pagina.slice(1));
  }catch(e){errore(e)}
}

let soggettiCache=[];
async function mostraGenealogia(){
  try{
    soggettiCache=await leggi("soggetti");
    const cerca=(valore("cercaGenealogia")||"").toLowerCase();
    const risultati=soggettiCache.filter(s=>
      (s.nome||"").toLowerCase().includes(cerca)||
      (s.codice||"").toLowerCase().includes(cerca)||
      (s.anellino||"").toLowerCase().includes(cerca));
    const contenitore=document.getElementById("risultatoGenealogia");
    if(!risultati.length){contenitore.innerHTML='<div class="empty">Nessun soggetto trovato.</div>';return}
    contenitore.innerHTML=risultati.map(s=>{
      const figli=soggettiCache.filter(f=>(f.padre&&f.padre===s.anellino)||(f.madre&&f.madre===s.anellino)||(f.padre&&f.padre===s.nome)||(f.madre&&f.madre===s.nome));
      return `<div class="item"><h3>🌳 ${esc(s.nome||s.codice||s.anellino)}</h3>
        <p><b>Padre:</b> ${esc(s.padre||"Non registrato")}</p><p><b>Madre:</b> ${esc(s.madre||"Non registrata")}</p>
        <p><b>Discendenza registrata:</b> ${figli.length}</p>
        ${figli.length?`<p>${figli.map(f=>esc(f.nome||f.codice||f.anellino||"-")).join(", ")}</p>`:""}
      </div>`;
    }).join("");
  }catch(e){errore(e)}
}
function esc(v){
  return String(v??"").replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#039;");
}
