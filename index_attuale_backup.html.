<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MyAgari Manager</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#222}
header{background:#1f2937;color:#fff;padding:20px;text-align:center}
header h1{margin:0;font-size:25px} header p{margin:6px 0 0;opacity:.8}
.container{max-width:1000px;margin:auto;padding:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}
.card,.item{background:#fff;border-radius:14px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.item{border:1px solid #e5e7eb;box-shadow:none;margin-bottom:10px}
.card h2,.card h3{margin-top:0}
button{border:0;border-radius:9px;padding:11px 15px;cursor:pointer;background:#2563eb;color:#fff;font-size:15px;margin:3px}
button.secondary{background:#6b7280}button.danger{background:#dc2626}button.success{background:#16a34a}
input,select,textarea{width:100%;padding:11px;margin-top:6px;margin-bottom:12px;border:1px solid #d1d5db;border-radius:8px;font-size:15px}
label{font-weight:bold}.hidden{display:none}.page-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px}
.empty{text-align:center;padding:30px;color:#6b7280}.back{margin-bottom:15px}
#loginScreen{max-width:420px;margin:50px auto;padding:24px;background:#fff;border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.status{padding:10px;border-radius:8px;margin:10px 0;background:#eef2ff}
.error{background:#fee2e2;color:#991b1b}.ok{background:#dcfce7;color:#166534}
.actions{display:flex;flex-wrap:wrap;gap:5px}.small{font-size:13px;color:#6b7280}
</style>
</head>
<body>

<div id="loginScreen">
  <h2>Accedi</h2>
  <input id="loginEmail" type="email" placeholder="Email">
  <input id="loginPassword" type="password" placeholder="Password">
  <button onclick="loginSupabase()">Accedi</button>
  <button class="secondary" onclick="registratiSupabase()">Crea account</button>
  <p id="loginMessage"></p>
</div>

<div id="app" class="hidden">
<header>
  <h1>🐦 MyAgari Manager</h1>
  <p>Gestione del mio allevamento</p>
</header>

<div class="container">
<section id="home">
  <div class="card">
    <div class="page-title">
      <div><h2>Benvenuto in MyAgari Manager</h2><div class="small" id="utenteLoggato"></div><div id="statoAccount"></div></div>
      <button class="secondary" onclick="logout()">Esci</button>
    </div>
  </div>

  <div class="grid">
    <div class="card"><h2>🐦 Soggetti</h2><p>Gestisci tutti i tuoi uccelli.</p><button onclick="apriPagina('soggetti')">Apri Soggetti</button></div>
    <div class="card"><h2>👫 Coppie</h2><p>Gestisci le coppie del tuo allevamento.</p><button onclick="apriPagina('coppie')">Apri Coppie</button></div>
    <div class="card"><h2>🐣 Riproduzione</h2><p>Gestisci covate e riproduzioni.</p><button onclick="apriPagina('riproduzione')">Apri Riproduzione</button></div>
    <div class="card"><h2>🌳 Genealogia</h2><p>Visualizza genitori e discendenza.</p><button onclick="apriPagina('genealogia')">Apri Genealogia</button></div>
    <div class="card"><h2>🏠 Gabbie</h2><p>Gestisci le gabbie dell'allevamento.</p><button onclick="apriPagina('gabbie')">Apri Gabbie</button></div>
    <div class="card"><h2>🌾 Alimentazione</h2><p>Gestisci alimentazione e programmi.</p><button onclick="apriPagina('alimentazione')">Apri Alimentazione</button></div>
    <div class="card"><h2>💍 Anellini</h2><p>Gestisci gli anellini dei soggetti.</p><button onclick="apriPagina('anellini')">Apri Anellini</button></div>
    <div class="card"><h2>📅 Calendario</h2><p>Gestisci gli eventi dell'allevamento.</p><button onclick="apriPagina('calendario')">Apri Calendario</button></div>
    <div class="card"><h2>❤️ Salute</h2><p>Gestisci controlli e note sulla salute.</p><button onclick="apriPagina('salute')">Apri Salute</button></div>
  </div>
</section>

<section id="soggetti" class="hidden">
  <div class="page-title"><h2>🐦 Soggetti</h2><button onclick="mostraForm('formSoggetto')">+ Nuovo soggetto</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formSoggetto" class="card hidden">
    <h3>Nuovo soggetto</h3>
    <label>Codice</label><input id="s_codice" placeholder="Codice soggetto">
    <label>Anellino</label><input id="s_anellino" placeholder="Es. IT 26 001">
    <label>Nome</label><input id="s_nome" placeholder="Nome del soggetto">
    <label>Sesso</label><select id="s_sesso"><option value="">Seleziona</option><option>Maschio</option><option>Femmina</option></select>
    <label>Data di nascita</label><input id="s_data" type="date">
    <label>Specie</label><input id="s_specie" placeholder="Es. Canarino">
    <label>Razza</label><input id="s_razza" placeholder="Es. Spagnolo">
    <label>Mutazione</label><input id="s_mutazione" placeholder="Es. Giallo intenso">
    <label>Padre</label><input id="s_padre" placeholder="Anellino, codice o nome">
    <label>Madre</label><input id="s_madre" placeholder="Anellino, codice o nome">
    <label>Gabbia</label><input id="s_gabbia" placeholder="Numero o codice gabbia">
    <label>Stato</label><input id="s_stato" placeholder="Es. Attivo">
    <label>Foto URL</label><input id="s_foto_url" placeholder="URL della foto, se disponibile">
    <label>Note</label><textarea id="s_note" rows="4"></textarea>
    <button class="success" onclick="salvaSoggetto()">Salva soggetto</button><button class="secondary" onclick="nascondiForm('formSoggetto')">Annulla</button>
  </div>
  <div id="listaSoggetti"></div>
</section>

<section id="coppie" class="hidden">
  <div class="page-title"><h2>👫 Coppie</h2><button onclick="mostraForm('formCoppia')">+ Nuova coppia</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formCoppia" class="card hidden">
    <h3>Nuova coppia</h3>
    <label>Codice</label><input id="c_codice" placeholder="Es. CP-001">
    <label>Maschio</label><input id="c_maschio" placeholder="Anellino, codice o nome">
    <label>Femmina</label><input id="c_femmina" placeholder="Anellino, codice o nome">
    <label>Data formazione</label><input id="c_data" type="date">
    <label>Stato</label><input id="c_stato" placeholder="Es. Attiva">
    <label>ID attivi</label><input id="c_id_attivi" placeholder="ID attivi, se utilizzati">
    <label>Note</label><textarea id="c_note"></textarea>
    <button class="success" onclick="salvaCoppia()">Salva coppia</button><button class="secondary" onclick="nascondiForm('formCoppia')">Annulla</button>
  </div>
  <div id="listaCoppie"></div>
</section>

<section id="riproduzione" class="hidden">
  <div class="page-title"><h2>🐣 Riproduzione</h2><button onclick="mostraForm('formRiproduzione')">+ Nuova riproduzione</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formRiproduzione" class="card hidden">
    <h3>Nuova riproduzione</h3>
    <label>Coppia / nidiata</label><input id="r_coppia_nidiata" placeholder="Codice coppia o nidiata">
    <label>Data deposizione</label><input id="r_data_deposizione" type="date">
    <label>Uova</label><input id="r_uova" type="number" min="0">
    <label>Feconde</label><input id="r_feconde" type="number" min="0">
    <label>Schiuse</label><input id="r_schiuse" type="number" min="0">
    <label>Spezzati</label><input id="r_spezzati" type="number" min="0">
    <label>Data spezzamento</label><input id="r_data_spezzamento" type="date">
    <label>Stato</label><input id="r_stato" placeholder="Es. In corso / Terminata">
    <label>Note</label><textarea id="r_note"></textarea>
    <button class="success" onclick="salvaRiproduzione()">Salva</button><button class="secondary" onclick="nascondiForm('formRiproduzione')">Annulla</button>
  </div>
  <div id="listaRiproduzione"></div>
</section>

<section id="genealogia" class="hidden">
  <h2>🌳 Genealogia</h2>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div class="card">
    <p>Cerca un soggetto per visualizzare padre, madre e discendenza registrati.</p>
    <label>Cerca soggetto</label><input id="cercaGenealogia" placeholder="Nome, codice o anellino" oninput="mostraGenealogia()">
    <div id="risultatoGenealogia"></div>
  </div>
</section>

<section id="gabbie" class="hidden">
  <div class="page-title"><h2>🏠 Gabbie</h2><button onclick="mostraForm('formGabbia')">+ Nuova gabbia</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formGabbia" class="card hidden">
    <label>Numero</label><input id="g_numero" placeholder="Es. 01">
    <label>Posizione</label><input id="g_posizione">
    <label>Tipo</label><input id="g_tipo" placeholder="Es. Cova / Voliera">
    <label>Capacità</label><input id="g_capacita" type="number" min="0">
    <label>Capacità soggetti</label><input id="g_capacita_soggetti" type="number" min="0">
    <label>Coppia / soggetti</label><input id="g_coppia_soggetti" placeholder="Coppia o soggetti presenti">
    <label>Stato</label><input id="g_stato" placeholder="Es. Libera / Occupata">
    <label>Note</label><textarea id="g_note"></textarea>
    <button class="success" onclick="salvaGabbia()">Salva gabbia</button><button class="secondary" onclick="nascondiForm('formGabbia')">Annulla</button>
  </div>
  <div id="listaGabbie"></div>
</section>

<section id="alimentazione" class="hidden">
  <div class="page-title"><h2>🌾 Alimentazione</h2><button onclick="mostraForm('formAlimentazione')">+ Nuovo alimento</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formAlimentazione" class="card hidden">
    <label>Data</label><input id="a_data" type="date">
    <label>Alimento</label><input id="a_alimento" placeholder="Es. Miscela semi">
    <label>Specie</label><input id="a_specie" placeholder="Es. Canarino">
    <label>Fase</label><input id="a_fase" placeholder="Es. Mantenimento / Cova">
    <label>Quantità</label><input id="a_quantita" type="number" step="any">
    <label>Unità</label><input id="a_unita" placeholder="Es. g">
    <label>Frequenza</label><input id="a_frequenza" placeholder="Es. Giornaliera">
    <label>Note</label><textarea id="a_note"></textarea>
    <button class="success" onclick="salvaAlimentazione()">Salva</button><button class="secondary" onclick="nascondiForm('formAlimentazione')">Annulla</button>
  </div>
  <div id="listaAlimentazione"></div>
</section>

<section id="anellini" class="hidden">
  <div class="page-title"><h2>💍 Anellini</h2><button onclick="mostraForm('formAnellino')">+ Nuovo anellino</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formAnellino" class="card hidden">
    <label>Anno</label><input id="an_anno" type="number"><label>Anno</label><input id="an_anno" type="number"><label>Numero</label><input id="an_numero">
    <label>Colore</label><input id="an_colore">
    <label>Misura</label><input id="an_misura">
    <label>Tipo</label><input id="an_tipo">
    <label>Oggetto</label><input id="an_oggetto">
    <label>Stato</label><select id="an_stato"><option>Disponibile</option><option>Assegnato</option><option>Utilizzato</option></select>
    <label>Note</label><textarea id="an_note"></textarea>
    <button class="success" onclick="salvaAnellino()">Salva anellino</button><button class="secondary" onclick="nascondiForm('formAnellino')">Annulla</button>
  </div>
  <div id="listaAnellini"></div>
</section>

<section id="calendario" class="hidden">
  <div class="page-title"><h2>📅 Calendario</h2><button onclick="mostraForm('formCalendario')">+ Nuovo evento</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formCalendario" class="card hidden">
    <label>Data</label><input id="cal_data" type="date">
    <label>Evento</label><input id="cal_evento" placeholder="Es. Controllo nido">
    <label>Categoria</label><input id="cal_categoria">
    <label>Coppia / soggetto</label><input id="cal_coppia_soggetto">
    <label>Stato</label><input id="cal_stato">
    <label>Note</label><textarea id="cal_note"></textarea>
    <button class="success" onclick="salvaCalendario()">Salva evento</button><button class="secondary" onclick="nascondiForm('formCalendario')">Annulla</button>
  </div>
  <div id="listaCalendario"></div>
</section>

<section id="salute" class="hidden">
  <div class="page-title"><h2>❤️ Salute</h2><button onclick="mostraForm('formSalute')">+ Nuovo controllo</button></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="formSalute" class="card hidden">
    <label>Soggetto</label><input id="sal_soggetto">
    <label>Data</label><input id="sal_data" type="date">
    <label>Tipo</label><input id="sal_tipo" placeholder="Es. Controllo / Terapia">
    <label>Peso</label><input id="sal_peso" type="number" step="any">
    <label>Trattamento</label><textarea id="sal_trattamento"></textarea>
    <label>Scadenza</label><input id="sal_scadenza" type="date">
    <label>Note</label><textarea id="sal_note"></textarea>
    <button class="success" onclick="salvaSalute()">Salva</button><button class="secondary" onclick="nascondiForm('formSalute')">Annulla</button>
  </div>
  <div id="listaSalute"></div>
</section>

<section id="admin" class="hidden">
  <div class="page-title"><h2>👑 Amministrazione</h2></div>
  <button class="secondary back" onclick="tornaHome()">← Torna alla schermata principale</button>
  <div id="adminList"></div>
</section>
</div>
</div>

<script>
/*
  MyAgari Manager
  Supabase: sostituire SOLO questi due valori con quelli del proprio progetto.
  Non inserire mai la Secret API key.
*/
const SUPABASE_URL = "https://mddsmqwfufzebahemxcn.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1kZHNtcXdmdWZ6ZWJhaGVteGNuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYzOTMyMTksImV4cCI6MjEwMTk2OTIxOX0.UXzR227VZ1EBwq4fuGapZQen3ekGvGIzezfvJZbXojY";
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

const sezioni=["home","soggetti","coppie","riproduzione","genealogia","gabbie","alimentazione","anellini","calendario","salute","admin"];
let profilo=null;

function msg(text, ok=false){
  const el=document.getElementById("loginMessage");
  if(!el)return;
  el.textContent=text;
  el.className=ok?"ok":"error";
}

function mostraForm(id){document.getElementById(id).classList.remove("hidden")}
function nascondiForm(id){document.getElementById(id).classList.add("hidden")}

function nascondiTutto(){
  sezioni.forEach(id=>{const el=document.getElementById(id);if(el)el.classList.add("hidden")});
}
async function apriPagina(nome){
  if(nome!=="home" && nome!=="admin" && !accessoValido()){alert("Accesso non attivo o abbonamento scaduto.");return}
  if(nome==="admin" && profilo?.ruolo!=="admin"){alert("Accesso negato.");return}
  nascondiTutto();
  document.getElementById(nome).classList.remove("hidden");
  if(nome==="soggetti")await aggiornaSoggetti();
  if(nome==="coppie")await aggiornaCoppie();
  if(nome==="riproduzione")await aggiornaRiproduzione();
  if(nome==="genealogia")await mostraGenealogia();
  if(nome==="gabbie")await aggiornaGabbie();
  if(nome==="alimentazione")await aggiornaLista("alimentazione","listaAlimentazione");
  if(nome==="anellini")await aggiornaLista("anellini","listaAnellini");
  if(nome==="calendario")await aggiornaLista("calendario","listaCalendario");
  if(nome==="salute")await aggiornaLista("salute","listaSalute");
  if(nome==="admin")costruisciAdmin();
}
function tornaHome(){apriPagina("home")}

async function utenteCorrente(){
  const {data,error}=await sb.auth.getUser();
  if(error||!data.user)throw new Error("Utente non autenticato.");
  return data.user;
}
async function inserisci(tabella,record){
  const user=await utenteCorrente();
  record.user_id=user.id;
  const {error}=await sb.from(tabella).insert(record);
  if(error)throw error;
}
async function leggi(tabella){
  const {data,error}=await sb.from(tabella).select("*").order("created_at",{ascending:false});
  if(error)throw error;
  return data||[];
}
async function elimina(tabella,id){
  const {error}=await sb.from(tabella).delete().eq("id",id);
  if(error)throw error;
}
function errore(error){alert("Errore Supabase: "+(error?.message||error))}
function valore(id){return document.getElementById(id).value.trim()}
function numero(id){const v=valore(id);return v===""?null:Number(v)}
function pulisciForm(id){
  document.querySelectorAll("#"+id+" input, #"+id+" textarea").forEach(e=>e.value="");
  document.querySelectorAll("#"+id+" select").forEach(e=>e.selectedIndex=0);
}

async function caricaProfilo(){
  const u=await utenteCorrente();
  const {data,error}=await sb.from("profili_utenti").select("*").eq("user_id",u.id).single();
  if(error)throw error; profilo=data; return data;
}
function accessoValido(){
  if(!profilo || profilo.attivo!==true)return false;
  if(profilo.illimitato===true)return true;
  if(!profilo.scadenza)return false;
  const oggi=new Date(); oggi.setHours(0,0,0,0);
  return new Date(profilo.scadenza+"T23:59:59")>=oggi;
}
function mostraStatoAccount(){
  const el=document.getElementById("statoAccount"); if(!el||!profilo)return;
  if(profilo.ruolo==="admin" && profilo.illimitato){el.innerHTML='<div class="status ok">👑 Amministratore · ♾️ Accesso illimitato</div>';return}
  if(!profilo.attivo){el.innerHTML='<div class="status error">Account disattivato.</div>';return}
  if(profilo.illimitato){el.innerHTML='<div class="status ok">♾️ Accesso illimitato</div>';return}
  el.innerHTML='<div class="status ok">Accesso fino al <b>'+esc(profilo.scadenza||"-")+'</b></div>';
}
function costruisciAdmin(){
  if(profilo?.ruolo!=="admin")return;
  const card='<div class="card"><h3>👑 Gestione utenti</h3><p class="small">Imposta attivazione, scadenza, accesso illimitato e ruolo.</p></div>';
  document.getElementById("adminList").innerHTML=card+'<div id="adminRows"></div>';
  caricaUtentiAdmin();
}
async function caricaUtentiAdmin(){
  const box=document.getElementById("adminRows"); if(!box)return;
  const {data,error}=await sb.from("profili_utenti").select("*").order("created_at",{ascending:false});
  if(error){box.innerHTML='<div class="card error">'+esc(error.message)+'</div>';return}
  box.innerHTML=(data||[]).map(p=>`<div class="card"><h3>${p.ruolo==="admin"?'👑':'👤'} ${esc(p.nome||p.email||"Utente")}</h3>
    <p><b>Email:</b> ${esc(p.email||"-")}</p>
    <label>Attivo</label><select id="att_${p.user_id}"><option value="true" ${p.attivo?'selected':''}>Sì</option><option value="false" ${!p.attivo?'selected':''}>No</option></select>
    <label>Illimitato</label><select id="ill_${p.user_id}"><option value="false" ${!p.illimitato?'selected':''}>No</option><option value="true" ${p.illimitato?'selected':''}>Sì</option></select>
    <label>Scadenza</label><input id="exp_${p.user_id}" type="date" value="${esc(p.scadenza||"")}">
    <label>Ruolo</label><select id="role_${p.user_id}"><option value="utente" ${p.ruolo==='utente'?'selected':''}>Utente</option><option value="admin" ${p.ruolo==='admin'?'selected':''}>Admin</option></select>
    <button class="success" onclick="salvaProfiloAdmin('${p.user_id}')">Salva modifiche</button></div>`).join("");
}
async function salvaProfiloAdmin(id){
  const payload={attivo:document.getElementById("att_"+id).value==="true",illimitato:document.getElementById("ill_"+id).value==="true",scadenza:document.getElementById("exp_"+id).value||null,ruolo:document.getElementById("role_"+id).value};
  const {error}=await sb.from("profili_utenti").update(payload).eq("user_id",id);
  if(error){alert("Errore: "+error.message);return} alert("Profilo aggiornato."); caricaUtentiAdmin();
}
async function loginSupabase(){
  const email=valore("loginEmail"),password=document.getElementById("loginPassword").value;
  if(!email||!password){msg("Inserisci email e password.");return}
  const {error}=await sb.auth.signInWithPassword({email,password});
  if(error){msg(error.message);return}
  await mostraApp();
}
async function registratiSupabase(){
  const email=valore("loginEmail"),password=document.getElementById("loginPassword").value;
  if(!email||!password){msg("Inserisci email e password.");return}
  const {data,error}=await sb.auth.signUp({email,password});
  if(error){msg(error.message);return}
  if(data.session)await mostraApp();
  else msg("Account creato. Controlla la tua email se Supabase richiede la conferma.",true);
}
async function logout(){await sb.auth.signOut();location.reload()}
async function mostraApp(){
  try{await caricaProfilo();}catch(e){msg("Profilo non disponibile: "+e.message);return}
  if(!accessoValido() && profilo.ruolo!=="admin"){msg("Il tuo accesso non è attivo o è scaduto.");return}
  document.getElementById("loginScreen").classList.add("hidden");
  document.getElementById("app").classList.remove("hidden");
  try{
    const u=await utenteCorrente();
    document.getElementById("utenteLoggato").textContent="Account: "+(u.email||"utente");
    mostraStatoAccount();
    if(profilo.ruolo==="admin"){document.querySelector("#home .grid").insertAdjacentHTML("beforeend",`<div class="card"><h2>👑 Amministrazione</h2><p>Gestisci utenti e scadenze.</p><button onclick="apriPagina('admin')">Apri amministrazione</button></div>`)}
