        const m = c.maschio.nome || c.maschio.codice || "Maschio";
        const f = c.femmina.nome || c.femmina.codice || "Femmina";

        messaggio +=
          "\\n" + (i+1) + ". " + m + " × " + f +
          "\\n   Razza: " +
          (c.maschio.razza || c.femmina.razza || "non specificata") +
          "\\n   Mutazione maschio: " +
          (c.maschio.mutazione || "non specificata") +
          "\\n   Mutazione femmina: " +
          (c.femmina.mutazione || "non specificata") +
          "\\n";
      });
    }

    if(escluse.length){
      messaggio +=
        "\\n⚠️ Coppie escluse per possibile parentela: " +
        escluse.length;
    }

    const box = $("risultatoAICoppie");

if(!box){
  alert("Errore: area risultati AI non trovata.");
  return;
}

box.innerHTML = `
