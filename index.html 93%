        '<p class="small">'+(c.data_aggiornamento?'<b>Aggiornamento:</b> '+esc(String(c.data_aggiornamento))+' · ':'')+(c.fonte?'<b>Fonte:</b> '+esc(c.fonte):'')+'</p></div>';
    }).join('');
    box.innerHTML='<div class="card"><h3>🏆 '+esc(nomeRazza)+' — Forma e posizione</h3><p class="small">Criteri trovati: <b>'+criteri.length+'</b>'+(versioni.length?' · Standard: '+esc(versioni.join(', ')):'')+'</p><p>Inserisci i punteggi. Il totale viene calcolato automaticamente.</p><div class="page-title"><strong>Totale: <span id="foiTotale">0</span> pt</strong><strong>Valutati: <span id="foiValutati">0</span>/'+criteri.length+'</strong></div><button id="salvaValutazioneFOI" class="success" type="button">💾 Salva valutazione</button><div id="foiSalvataggioMessaggio" class="small"></div></div>'+righe;
