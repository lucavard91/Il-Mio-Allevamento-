<script>
"use strict";
// MyAgari Manager — struttura consolidata v1.0

const SUPABASE_URL="https://mddsmqwfufzebahemxcn.supabase.co";
const SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1kZHNtcXdmdWZ6ZWJhaGVteGNuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYzOTMyMTksImV4cCI6MjEwMTk2OTIxOX0.UXzR227VZ1EBwq4fuGapZQen3ekGvGIzezfvJZbXojY";

const sezioni=["home","soggetti","coppie","riproduzione","genealogia","gabbie","alimentazione","anellini","calendario","salute","admin","aiValutazione"];
let sb=null;
let profilo=null;
let soggettiCache=[];

function $ (id){return document.getElementById(id);}
function valore(id){const e=$(id);return e?e.value.trim():"";}
function numero(id){const v=valore(id);return v===""?null:Number(v);}
function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]));}

function msg(text,ok=false){
  const el=$("loginMessage"); if(!el)return;
  el.textContent=text; el.className=ok?"ok":"error";
}
function resetMsg(text,ok=false){
  const el=$("resetMessage"); if(!el)return;
  el.textContent=text; el.className=ok?"ok":"error";
}
function toggle(id,show){const e=$(id);if(e)e.classList.toggle("hidden",!show);}
function mostraForm(id){toggle(id,true);}
function nascondiForm(id){toggle(id,false);}
function pulisciForm(id){
  const box=$(id); if(!box)return;
  box.querySelectorAll("input,textarea").forEach(e=>e.value="");
  box.querySelectorAll("select").forEach(e=>e.selectedIndex=0);
}
function nascondiTutto(){sezioni.forEach(id=>toggle(id,false));}

function accessoValido(){
  if(!profilo||profilo.attivo!==true)return false;
  if(profilo.illimitato===true)return true;
  if(!profilo.scadenza)return false;
  const oggi=new Date();oggi.setHours(0,0,0,0);
  return new Date(profilo.scadenza+"T23:59:59")>=oggi;
}

async function utenteCorrente(){
  const {data,error}=await sb.auth.getUser();
  if(error||!data.user)throw new Error("Utente non autenticato.");
  return data.user;
}
async function caricaProfilo(){
  const u=await utenteCorrente();
  const {data,error}=await sb.from("profili_utenti").select("*").eq("user_id",u.id).single();
  if(error)throw error;
  profilo=data;
  return data;
}
async function inserisci(tabella,record){
  const u=await utenteCorrente();
  record.user_id=u.id;
  const {error}=await sb.from(tabella).insert(record);
  if(error)throw error;
}
async function leggi(tabella){
  const {data,error}=await sb.from(tabella).select("*").order("created_at",{ascending:false});
  if(error)throw error;
  return data||[];
}
async function elimina(tabella,id){
  const {error}=await sb.from(tabella).delete().eq("id",id);
  if(error)throw error;
}
function errore(e){alert("Errore Supabase: "+(e?.message||e));}

function mostraStatoAccount(){
  const el=$("statoAccount");if(!el||!profilo)return;
  if(profilo.ruolo==="admin"&&profilo.illimitato){el.innerHTML='<div class="status ok">👑 Amministratore · ♾️ Accesso illimitato</div>';return;}
  if(!profilo.attivo){el.innerHTML='<div class="status error">Account disattivato.</div>';return;}
  if(profilo.illimitato){el.innerHTML='<div class="status ok">♾️ Accesso illimitato</div>';return;}
  el.innerHTML='<div class="status ok">Accesso fino al <b>'+esc(profilo.scadenza||"-")+'</b></div>';
}

async function apriPagina(nome){
  if(nome!=="home"&&nome!=="admin"&&!accessoValido()){alert("Accesso non attivo o abbonamento scaduto.");return;}
  if(nome==="admin"&&profilo?.ruolo!=="admin"){alert("Accesso negato.");return;}
  nascondiTutto();toggle(nome,true);
  try{
    if(nome==="soggetti")await aggiornaSoggetti();
    if(nome==="standardFOI")await inizializzaStandardFOI();
    if(nome==="coppie")await aggiornaCoppie();
    if(nome==="riproduzione")await aggiornaRiproduzione();
    if(nome==="genealogia")await mostraGenealogia();
    if(nome==="gabbie")await aggiornaGabbie();
    if(["alimentazione","anellini","calendario","salute"].includes(nome))await aggiornaLista(nome);
    if(nome==="admin")await costruisciAdmin();
  }catch(e){errore(e);}
}

async function loginSupabase(){
