async function gestisciAccesso(id){
 const scelta=prompt("Inserisci la nuova durata in mesi (es. 6, 11, 12, 15, 24) oppure una data in formato GG/MM/AAAA (es. 30/12/2026).\nPuoi anche usare AAAA-MM-GG.\nScrivi ILLIMITATO per accesso senza scadenza.");
 if(scelta===null)return;
 let payload;
 if(scelta.trim().toUpperCase()==="ILLIMITATO")payload={attivo:true,illimitato:true,scadenza:null};
 else if(/^\d{2}\/\d{2}\/\d{4}$/.test(scelta.trim())){const [gg,mm,aaaa]=scelta.trim().split("/");const d=new Date(Number(aaaa),Number(mm)-1,Number(gg));if(d.getFullYear()!==Number(aaaa)||d.getMonth()!==Number(mm)-1||d.getDate()!==Number(gg)){alert("Data non valida.");return;}payload={attivo:true,illimitato:false,scadenza:`${aaaa}-${mm}-${gg}`};}
 else if(/^\d{4}-\d{2}-\d{2}$/.test(scelta.trim()))payload={attivo:true,illimitato:false,scadenza:scelta.trim()};
 else if(/^\d+(?:[.,]\d+)?$/.test(scelta.trim())){const mesi=Number(scelta.replace(',','.'));if(mesi<=0)throw new Error("Durata non valida.");const d=new Date();d.setHours(12,0,0,0);d.setMonth(d.getMonth()+Math.floor(mesi));if(mesi%1)d.setDate(d.getDate()+Math.round((mesi%1)*30));payload={attivo:true,illimitato:false,scadenza:d.toISOString().slice(0,10)};}
 else {alert("Inserisci un numero di mesi, una data YYYY-MM-DD oppure ILLIMITATO.");return;}
 try{await aggiornaProfilo(id,payload);alert("✅ Accesso aggiornato.");await costruisciAdmin();}catch(e){errore(e);}
}
