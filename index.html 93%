async function caricaFotoSoggetto(soggettoId,file){
  const u=await utenteCorrente();
  if(!file || !file.type || !file.type.startsWith("image/")) throw new Error("Seleziona un file immagine.");
  const ext=(file.name.split(".").pop()||"jpg").toLowerCase().replace(/[^a-z0-9]/g,"")||"jpg";
  const path=`${u.id}/${soggettoId}-${Date.now()}.${ext}`;
  const up=await sb.storage.from("myagari-foto").upload(path,file,{upsert:true,contentType:file.type});
  if(up.error) throw up.error;
  const {data:pub}=sb.storage.from("myagari-foto").getPublicUrl(path);
  if(!pub?.publicUrl) throw new Error("Impossibile ottenere l'indirizzo della foto.");
  const {error}=await sb.from("soggetti").update({foto_url:pub.publicUrl}).eq("id",soggettoId);
  if(error) throw error;
  return pub.publicUrl;
}

