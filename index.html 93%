      String(s.sesso || "").toLowerCase().includes("masch")
    );

    const femmine = data.filter(s =>
      String(s.sesso || "").toLowerCase().includes("femm")
    );

    if(maschi.length === 0 || femmine.length === 0){
      alert("Servono almeno un maschio e una femmina registrati.");
      return;
    }

    const stessoSoggetto = (a,b) => a.id === b.id;

    const sonoGenitoriDiretti = (a,b) => {
      return a.padre_id === b.id ||
             a.madre_id === b.id ||
             b.padre_id === a.id ||
             b.madre_id === a.id;
    };

    const sonoFratelli = (a,b) => {
      if(!a.padre_id || !a.madre_id || !b.padre_id || !b.madre_id) return false;

      return (
        a.padre_id === b.padre_id &&
        a.madre_id === b.madre_id
      );
    };

    const coppie = [];

    maschi.forEach(maschio => {
      femmine.forEach(femmina => {

        if(stessoSoggetto(maschio,femmina)) return;

        let esclusa = false;
