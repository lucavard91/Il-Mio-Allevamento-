async function mostraCalendarioMensile(){
  try{
    const box=$("calendarioMensile");
    const titolo=$("titoloMeseCalendario");
    if(!box||!titolo)return;

    const anno=meseCalendario.getFullYear();
    const mese=meseCalendario.getMonth();
const oggi=new Date();
const dataOggi=
  `${oggi.getFullYear()}-${String(oggi.getMonth()+1).padStart(2,"0")}-${String(oggi.getDate()).padStart(2,"0")}`;
    const nomiMesi=[
      "Gennaio","Febbraio","Marzo","Aprile","Maggio","Giugno",
      "Luglio","Agosto","Settembre","Ottobre","Novembre","Dicembre"
    ];

    titolo.textContent=`${nomiMesi[mese]} ${anno}`;

    const eventi=await leggi("calendario");
    const riproduzioni=await leggi("riproduzione");

    const giorniTotali=new Date(anno,mese+1,0).getDate();
    const primoGiorno=(new Date(anno,mese,1).getDay()+6)%7;

    const giorniSettimana=[
      "Lun","Mar","Mer","Gio","Ven","Sab","Dom"
    ];

    let html=`
      <div style="
        width:100%;
        overflow:hidden;
      ">
        <div style="
          display:grid;
          grid-template-columns:repeat(7,minmax(0,1fr));
          gap:3px;
          width:100%;
        ">
          ${giorniSettimana.map(g=>`
            <div style="
              text-align:center;
              font-weight:bold;
              font-size:12px;
              padding:5px 1px;
              min-width:0;
            ">
              ${g}
            </div>
          `).join("")}
    `;

    for(let i=0;i<primoGiorno;i++){
      html+=`
        <div style="
          min-width:0;
          min-height:70px;
        "></div>
      `;
    }

    for(let giorno=1;giorno<=giorniTotali;giorno++){

      const data=
        `${anno}-${String(mese+1).padStart(2,"0")}-${String(giorno).padStart(2,"0")}`;

      const eventiGiorno=eventi.filter(
        e=>e.data===data
      );

      const eventiRiproduzione=[];

      riproduzioni.forEach(r=>{

        if(r.data_schiusa_prevista===data){
          eventiRiproduzione.push(`
            <div style="
              margin-top:3px;
              font-size:10px;
              line-height:1.2;
              overflow-wrap:anywhere;
            ">
              🐣 <b>Schiusa</b><br>
              ${esc(r.coppia||"-")}
            </div>
          `);
        }

        if(r.data_ultimo_uovo){

          const d=new Date(
            r.data_ultimo_uovo+"T00:00:00"
          );

          d.setDate(d.getDate()+7);

          const speratura=
            `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;

          if(speratura===data){
            eventiRiproduzione.push(`
              <div style="
                margin-top:3px;
                font-size:10px;
                line-height:1.2;
                overflow-wrap:anywhere;
              ">
                🔎 <b>Speratura</b><br>
                ${esc(r.coppia||"-")}
              </div>
            `);
          }
        }
      });

      const eventiManuali=eventiGiorno.map(e=>`

        <div
          class="calendar-event"
          data-calendar-event-id="${esc(e.id)}"
          style="
            margin-top:3px;
            padding:4px;
            border-radius:5px;
            background:#eef5ff;
            cursor:pointer;
            font-size:10px;
            line-height:1.2;
            min-width:0;
            max-width:100%;
            overflow:hidden;
            overflow-wrap:anywhere;
            word-break:break-word;
          "
          title="Tocca per visualizzare o eliminare l'evento"
        >
          📌 <b>${esc(e.evento||"Evento")}</b>
          ${
            e.coppia_soggetto
              ? `<br>${esc(e.coppia_soggetto)}`
              : ""
          }
        </div>

      `).join("");

      const contenuto=[
        ...eventiRiproduzione,
        eventiManuali
      ].join("");

      html+=`

        <div style="
          min-width:0;
          min-height:70px;
          border:1px solid #ddd;
          border-radius:6px;
          padding:4px;
          overflow:hidden;
          box-sizing:border-box;
        ">

          <div style="
  font-weight:bold;
  font-size:12px;
  margin-bottom:2px;
  color:${data===dataOggi ? "#16a34a" : "inherit"};
">
  ${data===dataOggi ? "🟢 " : ""}${giorno}
</div>

          ${contenuto}

        </div>

      `;
    }

    html+=`
        </div>
      </div>
    `;

    box.innerHTML=html;

    document
      .querySelectorAll(
        "#calendarioMensile [data-calendar-event-id]"
      )
      .forEach(el=>{

        el.onclick=()=>{

          apriDettaglioEventoCalendario(
            el.dataset.calendarEventId,
            eventi
          );

        };

      });

  }catch(e){
    errore(e);
  }
}
