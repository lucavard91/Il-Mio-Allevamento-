 }catch(e){
  const text="Errore di avvio: "+(e?.message||e);
  const el=$("loginMessage");if(el){el.textContent=text;el.className="error";}
  console.error(e);
 }
}

if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init);
else init();
