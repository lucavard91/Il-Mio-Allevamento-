  // In questo modo nessuna pagina può rimanere visibile sotto a quella richiesta.
  const pagineApp=document.querySelectorAll("#app > .container > section");
  pagineApp.forEach(e=>{
    e.classList.add("hidden");
    e.style.display="none";
  });

  // Mostra esclusivamente la pagina richiesta.
  const pagina=$(nome);
  if(pagina && pagina.parentElement?.matches("#app > .container")){
    pagina.classList.remove("hidden");
    pagina.style.display="block";
