        const {error:de}=await sb.from("foi_valutazioni_dettagli").delete().in("valutazione_id",vals.map(v=>v.id));
        if(de)throw de;
        const {error:e1}=await sb.from("foi_valutazioni").delete().eq("allevamento_id",allevamentoAttivo.id).in("id",vals.map(v=>v.id));
        if(e1)throw e1;
      }
      const {error:ae}=await sb.from("valutazioni_ai").delete().in("soggetto_id",ids);
      if(ae && !/does not exist|relation/i.test(ae.message||""))throw ae;
      const {error:fe}=await sb.from("soggetti_foto").delete().eq("allevamento_id",allevamentoAttivo.id).in("soggetto_id",ids);
      if(fe)throw fe;
    }
    for(const tabella of ["riproduzione","coppie","gabbie","alimentazione","salute","calendario","anellini","genealogia","soggetti"]){
      const {error}=await sb.from(tabella).delete().eq("allevamento_id",allevamentoAttivo.id);
      if(error)throw error;
    }
    try{
      const u=await utenteCorrente();
      const cartella=`${u.id}/${allevamentoAttivo.id}`;
      const {data:objects,error:listError}=await sb.storage.from("myagari-fot").list(cartella,{limit:1000});
      if(!listError && objects?.length){
        const paths=objects.map(o=>`${cartella}/${o.name}`);
        await sb.storage.from("myagari-fot").remove(paths);
      }
    }catch(storageError){console.warn("Pulizia foto storage non completata",storageError);}
    soggettiCache=[];
    alert("✅ Allevamento "+nome+" resettato. Gli altri allevamenti, l'account e l'abbonamento sono rimasti invariati.");
    await apriPagina("home");
