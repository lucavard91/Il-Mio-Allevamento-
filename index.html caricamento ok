<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MyAgari Manager</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
 .autocomplete {
  position: relative;
  width: 100%;
}

.suggerimenti {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: white;
  border: 1px solid #ccc;
  border-radius: 8px;
  max-height: 220px;
  overflow-y: auto;
  z-index: 9999;
}

.suggerimento-item {
  padding: 12px;
  cursor: pointer;
  border-bottom: 1px solid #eee;
}

.suggerimento-item:hover {
  background: #f0f0f0;
}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#222}
header{background:#1f2937;color:#fff;padding:20px;text-align:center}
header h1{margin:0;font-size:25px}
header p{margin:6px 0 0;opacity:.8}
.container{max-width:1000px;margin:auto;padding:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}
.card,.item{background:#fff;border-radius:14px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.item{border:1px solid #e5e7eb;box-shadow:none;margin-bottom:10px}
.card h2,.card h3{margin-top:0}
button{border:0;border-radius:9px;padding:11px 15px;cursor:pointer;background:#2563eb;color:#fff;font-size:15px;margin:3px}
button.secondary{background:#6b7280}
button.danger{background:#dc2626}
button.success{background:#16a34a}
input,select,textarea{width:100%;padding:11px;margin-top:6px;margin-bottom:12px;border:1px solid #d1d5db;border-radius:8px;font-size:15px}
label{font-weight:bold}
.hidden{
  display:none !important;
}
#allevamentoLoading{position:fixed;inset:0;z-index:20000;display:none;align-items:center;justify-content:center;background:rgba(17,24,39,.48);padding:20px;}
#allevamentoLoading.visible{display:flex;}
#allevamentoLoading .loading-card{background:#fff;border-radius:16px;padding:24px 28px;box-shadow:0 12px 40px rgba(0,0,0,.25);text-align:center;min-width:240px;}
#allevamentoLoading .spinner{width:42px;height:42px;border:4px solid #e5e7eb;border-top-color:#2563eb;border-radius:50%;animation:allevamentoSpin .8s linear infinite;margin:0 auto 14px;}
#allevamentoLoading p{margin:0;font-weight:bold;}
@keyframes allevamentoSpin{to{transform:rotate(360deg)}}
 .page-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px}
#formCalendario{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;background:rgba(17,24,39,.55);padding:20px;border-radius:0;box-shadow:none}
#formCalendario.hidden{display:none !important}
#formCalendario .calendar-form-inner{background:#fff;width:min(560px,100%);max-height:90vh;overflow:auto;border-radius:16px;padding:22px;box-shadow:0 12px 40px rgba(0,0,0,.25)}
.calendar-form-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.calendar-form-title h3{margin:0}
.admin-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
button:disabled{opacity:.55;cursor:not-allowed}

.empty{text-align:center;padding:30px;color:#6b7280}
.back{margin-bottom:15px}
#loginScreen,#resetScreen{max-width:420px;margin:50px auto;padding:24px;background:#fff;border-radius:14px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.status{padding:10px;border-radius:8px;margin:10px 0;background:#eef2ff}
.error{background:#fee2e2;color:#991b1b;padding:10px;border-radius:8px}
.ok{background:#dcfce7;color:#166534;padding:10px;border-radius:8px}
.small{font-size:13px;color:#6b7280}
.actions{display:flex;flex-wrap:wrap;gap:5px}
 .ai-coppia{
  background:#fff;
  border-radius:16px;
  padding:20px;
  margin-top:15px;
  box-shadow:0 3px 10px rgba(0,0,0,.10);
  border:2px solid #e5e7eb;
}

.ai-coppia h3{
  font-size:20px;
  margin-top:0;
}

.ai-coppia .ai-stato{
  font-size:18px;
  font-weight:bold;
  margin:10px 0;
}

.ai-coppia .ai-sezione{
  margin-top:15px;
  padding-top:12px;
  border-top:1px solid #e5e7eb;
}

.ai-coppia .ai-titolo{
  font-weight:bold;
  font-size:16px;
  margin-bottom:6px;
}

.ai-coppia .ai-spiegazione{
  line-height:1.5;
  font-size:15px;
}

.ai-coppie-container{
  margin-top:20px;
}

.ai-punteggio{
  font-size:22px;
  font-weight:bold;
  margin:10px 0;
} 
</style>

<style>
.soggetto-thumb{max-width:180px;max-height:180px;border-radius:12px;object-fit:cover;border:1px solid #e5e7eb}
.ai-foto{display:block;max-width:100%;max-height:420px;margin:12px auto;border-radius:14px;object-fit:contain;background:#f3f4f6}
.ai-foto-placeholder{min-height:180px;display:flex;align-items:center;justify-content:center;background:#f3f4f6;border-radius:14px;color:#6b7280;margin:12px 0}
.ai-guide{background:#f8fafc}
</style>
</head>
<body>
<div id="allevamentoLoading" aria-live="polite" aria-busy="true"><div class="loading-card"><div class="spinner" aria-hidden="true"></div><p id="allevamentoLoadingTitle">Cambio allevamento…</p><div class="small" style="margin-top:6px;">Caricamento dei dati in corso</div></div></div>

<div id="loginScreen">
  <h2>Accedi</h2>
  <input id="loginEmail" type="email" placeholder="Email">
  <input id="loginPassword" type="password" placeholder="Password">
  <button id="btnLogin">Accedi</button>
  <button id="btnRegister" class="secondary">Crea account</button>
  <button id="btnRecovery" class="secondary">Password dimenticata?</button>
  <button id="btnRecoverAccount" class="secondary">🔑 Recupera account</button>
  <p id="loginMessage"></p>
</div>
<div id="recoverAccountScreen" class="hidden">
  <h2>🔑 Recupera account</h2>
  <p class="small">
    Se hai già utilizzato MyAgari Manager ma non ricordi
    quale indirizzo email hai utilizzato, prova con gli indirizzi
    email che utilizzi abitualmente.
  </p>
  <input
    id="recoverAccountEmail"
    type="email"
    placeholder="Inserisci la tua email"
  >
  <button id="btnSendRecoverAccount" class="success">
    📧 Invia richiesta di recupero
  </button>
  <button id="btnCancelRecoverAccount" class="secondary">
    ← Torna ad Accedi
  </button>
  <p id="recoverAccountMessage"></p>
</div>
<div id="resetScreen" class="hidden">
  <h2>Reimposta password</h2>
  <p class="small">
    Inserisci la nuova password per il tuo account.
  </p>
  <input id="newPassword" type="password" placeholder="Nuova password">
  <input id="newPasswordConfirm" type="password" placeholder="Ripeti nuova password">
  <button id="btnUpdatePassword">
    Salva nuova password
  </button>
  <p id="resetMessage"></p>
</div>

<div id="app" class="hidden">
<header>
  <h1>🐦 MyAgari Manager</h1>
  <p>Gestione del mio allevamento</p>
</header>

<div class="container">
<section id="home">
  <div class="card">
    <div class="page-title">
      <div>
        <h2>Benvenuto in MyAgari Manager</h2>
        <div class="small" id="utenteLoggato"></div>
        <div id="statoAccount"></div>
      </div>

      <div style="display:flex;gap:8px;align-items:center;">
        <button id="btnAdminNotifications" class="secondary hidden" type="button" title="Richieste di approvazione">🔔 <span id="adminNotificationBadge" style="display:inline-block;min-width:18px;text-align:center;border-radius:999px;padding:1px 5px;background:#dc2626;color:#fff;font-size:11px;">0</span></button>
        <button id="btnLogout" class="secondary">Esci</button>
      </div>
    </div>
  </div>

  <div class="card">
  <h3>👤 Il mio profilo</h3>
  

  <p class="small">
    Inserisci i tuoi dati. Il numero RNA è facoltativo.
  </p>

  <label for="profiloNome">Nome</label>
  <input
    id="profiloNome"
    type="text"
    placeholder="Il tuo nome"
    autocomplete="given-name"
  >

  <label for="profiloCognome">Cognome</label>
  <input
    id="profiloCognome"
    type="text"
    placeholder="Il tuo cognome"
    autocomplete="family-name"
  >

  <label for="profiloRNA">RNA <span class="small">(facoltativo)</span></label>
  <input
    id="profiloRNA"
    type="text"
    placeholder="Numero RNA, se disponibile"
    autocomplete="off"
  >

  <button
    id="btnSalvaProfilo"
    class="success"
    type="button">
    💾 Salva profilo
  </button>

  <p id="profiloMessage" class="small"></p>
</div>
  <div id="selettoreAllevamentoBox"></div>
  <div class="grid" id="homeGrid">
    <div class="card"><h2>🐦 Soggetti</h2><p>Gestisci tutti i tuoi uccelli.</p><button data-page="soggetti">Apri Soggetti</button></div>
    <div class="card"><h2>👫 Coppie</h2><p>Gestisci le coppie del tuo allevamento.</p><button data-page="coppie">Apri Coppie</button></div>
    <div class="card"><h2>🐣 Riproduzione</h2><p>Gestisci covate e riproduzioni.</p><button data-page="riproduzione">Apri Riproduzione</button></div>
    <div class="card"><h2>🌳 Genealogia</h2><p>Visualizza genitori e discendenza.</p><button data-page="genealogia">Apri Genealogia</button></div>
    <div class="card"><h2>🏠 Gabbie</h2><p>Gestisci le gabbie dell'allevamento.</p><button data-page="gabbie">Apri Gabbie</button></div>
    <div class="card"><h2>🌾 Alimentazione</h2><p>Gestisci alimentazione e programmi.</p><button data-page="alimentazione">Apri Alimentazione</button></div>
    
    <div class="card"><h2>📅 Calendario</h2><p>Gestisci gli eventi dell'allevamento.</p><button data-page="calendario">Apri Calendario</button></div>
    <div class="card"><h2>❤️ Salute</h2><p>Gestisci controlli e note sulla salute.</p><button data-page="salute">Apri Salute</button></div>
    <div class="card"><h2>🏆 Standard FOI</h2><p>Consulta i criteri FOI disponibili nell'app.</p><button data-page="standardFOI">Apri Standard FOI</button></div>
    <div class="card"><h2>⚙️ Impostazioni</h2><p>Gestisci il profilo e, se necessario, esegui il reset dell'allevamento attualmente selezionato.</p><button id="btnResetAllevamento" class="danger" type="button">🔄 Reset allevamento</button></div>
  </div>
</section>

<section id="standardFOI" class="hidden">
  <div class="page-title"><h2>🏆 Standard FOI</h2></div>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>
  <div class="card">
    <h3>📋 Consultazione criteri FOI</h3>
    <p class="small">Seleziona prima la <b>specie</b>, poi la <b>mutazione / varietà</b>. La categoria FOI viene individuata automaticamente. La valutazione del singolo soggetto viene avviata dalla scheda del soggetto tramite <b>🤖 Valuta con AI</b>.</p>

    <label>Specie</label>
    <div class="autocomplete"><input id="foiSpecie" type="text" placeholder="Scrivi o seleziona la specie..." autocomplete="off"><div id="foiSuggerimentiSpecie" class="suggerimenti"></div></div>

    <label>Mutazione / varietà</label>
    <div class="autocomplete"><input id="foiMutazione" type="text" placeholder="Scrivi o seleziona la mutazione / varietà..." autocomplete="off"><div id="foiSuggerimentiMutazione" class="suggerimenti"></div></div>

    <label>Categoria FOI</label>
    <select id="foiCategoriaFOI"><option value="">— Seleziona prima la specie —</option></select>

    <label>Soggetto da consultare (facoltativo)</label>
    <select id="foiSoggetto"><option value="">— Nessun soggetto selezionato —</option></select>

    <label>Criterio FOI</label>
    <select id="foiCriterio"><option value="">— Tutti i criteri —</option></select>

    <button id="caricaStandardFOI" class="success" type="button">🔎 Consulta criteri FOI</button>
    <p class="small">La specie viene utilizzata per cercare i criteri FOI presenti nel database; la mutazione / varietà serve a identificare correttamente il soggetto e la categoria di appartenenza.</p>
    <div class="card" style="margin-top:12px;">
      <h3>📚 Standard ufficiali FOI</h3>
      <p class="small">Ultimo elenco verificato sul sito ufficiale FOI.</p>
      <ul style="padding-left:20px;">
        <li><a href="https://www.foi.it/mostre-ornitologiche-giudici/standard/criteri-di-giudizio-canarini-da-canto-malinois-2022.html" target="_blank" rel="noopener">Canarini da Canto Malinois — 2022 / edizione 2023</a></li>
        <li><a href="https://www.foi.it/mostre-ornitologiche-giudici/standard/standard-canarini-di-forma-e-posizione-lisci-edizione-2020.html" target="_blank" rel="noopener">Canarini F.P. Lisci — edizione 2020, aggiornamenti 2023</a></li>
        <li><a href="https://www.foi.it/mostre-ornitologiche-giudici/standard/standard-canarini-di-forma-e-posizione-arricciati-2020.html" target="_blank" rel="noopener">Canarini F.P. Arricciati — 2020, aggiornamento TorZuino 2023</a></li>
        <li><a href="https://www.foi.it/standard-estrildidi-fringillidi-ibridi-ed-affini" target="_blank" rel="noopener">Estrildidi, Fringillidi, Ibridi ed affini</a></li>
        <li><a href="https://www.foi.it/mostre-ornitologiche-giudici/standard.html" target="_blank" rel="noopener">Ondulati ed altri Psittaciformi — standard corrente</a></li>
        <li><a href="https://www.foi.it/standard-canarini-di-colore-2024-aggiornamento-standard-provvisorio-jaspe-doppio-fattore" target="_blank" rel="noopener">Canarini di Colore — 2024 / Jaspe doppio fattore</a></li>
      </ul>
      <p class="small"><a href="https://www.foi.it/mostre-ornitologiche-giudici/standard.html" target="_blank" rel="noopener">🔗 Apri la pagina Standard FOI ufficiale</a></p>
    </div>
  </div>
  <div id="risultatoStandardFOI"></div>
</section>

<section id="aiValutazione" class="hidden">
  <div class="page-title"><h2>🤖 Valutazione AI del soggetto</h2></div>
  <button class="secondary back" data-page="soggetti">← Torna ai soggetti</button>
  <div id="aiValutazioneRoot"></div>
</section>

<section id="soggetti" class="hidden">
  <div class="page-title"><h2>🐦 Soggetti</h2><button id="newSoggetto">+ Nuovo soggetto</button></div>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>
  <div id="formSoggetto" class="card hidden">
    <h3>Nuovo soggetto</h3>
    <label>Anno</label><input id="s_anno" type="number" placeholder="Es. 2026">
    <label>Numero</label><input id="s_numero" placeholder="Es. 53">
    <label>Sesso</label><select id="s_sesso"><option value="">Seleziona</option><option>Maschio</option><option>Femmina</option></select>
    <label>Specie</label>
<div class="autocomplete">
  <input id="s_specie" type="text" placeholder="Cerca specie..." autocomplete="off">
  <div id="suggerimentiSpecie" class="suggerimenti"></div>
</div>

<label>Razza</label>
<div class="autocomplete">
  <input id="s_razza" type="text" placeholder="Cerca razza..." autocomplete="off">
  <div id="suggerimentiRazza" class="suggerimenti"></div>
</div>

<label>Mutazione</label>
<div class="autocomplete">
  <input id="s_mutazione" type="text" placeholder="Cerca mutazione..." autocomplete="off">
  <div id="suggerimentiMutazione" class="suggerimenti"></div>
</div>
    <label>Padre</label><input id="s_padre" placeholder="Anellino, codice o nome">
    <label>Madre</label><input id="s_madre" placeholder="Anellino, codice o nome">
    <label>Gabbia</label><input id="s_gabbia" placeholder="Numero o codice gabbia">
    <label>Stato</label><input id="s_stato" placeholder="Es. Attivo">
    <label>Foto del soggetto (facoltativa)</label><input id="s_foto_file" type="file" accept="image/*">
    <label>Note</label><textarea id="s_note" rows="4"></textarea>
    <button id="saveSoggetto" class="success">Salva soggetto</button>
    <button id="cancelSoggetto" class="secondary">Annulla</button>
  </div>
  <div class="card">
    <h3>🔎 Cerca soggetto</h3>
    <label>Anno anellino</label><input id="cercaAnnoSoggetto" type="number" placeholder="Es. 2026">
    <label>Numero anellino</label><input id="cercaNumeroSoggetto" placeholder="Es. 53">
    <button id="searchSoggetto">🔍 Cerca</button>
    <button id="allSoggetti" class="secondary">Mostra tutti</button>
  </div>
  <div id="listaSoggetti"></div>
</section>

<section id="coppie" class="hidden">
  <div class="page-title"><h2>👫 Coppie</h2><button id="newCoppia">+ Nuova coppia</button></div>
  <div class="card">
  <h3>🤖 Formazione coppie con AI</h3>
  <p>L'intelligenza artificiale analizzerà i soggetti disponibili, la genetica e la genealogia per suggerire gli accoppiamenti più adatti a migliorare il ceppo.</p>
  <button id="btnAICoppie" class="success">🤖 Suggerisci coppie con AI</button>
    <div id="risultatoAICoppie"></div>
</div>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>
  <div id="formCoppia" class="card hidden">
    <h3>Nuova coppia</h3>
    <label>Codice</label><input id="c_codice" placeholder="Es. CP-001">
    <label>Maschio</label><input id="c_maschio" placeholder="Anellino, codice o nome">
    <label>Femmina</label><input id="c_femmina" placeholder="Anellino, codice o nome">
    <label>Data formazione</label><input id="c_data" type="date">
    <label>Stato</label><input id="c_stato" placeholder="Es. Attiva">
    <label>ID attivi</label><input id="c_id_attivi" placeholder="ID attivi, se utilizzati">
    <label>Note</label><textarea id="c_note"></textarea>
    <button id="saveCoppia" class="success">Salva coppia</button><button id="cancelCoppia" class="secondary">Annulla</button>
  </div>
  <div id="listaCoppie"></div>
</section>

<section id="riproduzione" class="hidden">
  <div class="page-title"><h2>🐣 Riproduzione</h2><button id="newRiproduzione">+ Nuova riproduzione</button></div>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>

  <div id="formRiproduzione" class="card hidden">
    <h3>Nuova riproduzione</h3>

    <label>Coppia</label>
    <input id="r_coppia" placeholder="Es. CP 1">

    <label>Data deposizione</label>
    <input id="r_data_deposizione" type="date">

    <label>Data ultimo uovo deposto</label>
    <input id="r_data_ultimo_uovo" type="date">

    <label>Data schiusa prevista</label>
    <input id="r_data_schiusa_prevista" type="date">

    <label>Uova</label>
    <input id="r_uova" type="number" min="0">

    <label>Feconde</label>
    <input id="r_feconde" type="number" min="0">

    <label>Schiuse</label>
    <input id="r_schiuse" type="number" min="0">

    <label>Svezzati</label>
    <input id="r_svezzati" type="number" min="0">

    <label>Data svezzamento</label>
    <input id="r_data_svezzamento" type="date">

    <label>Stato</label>
    <input id="r_stato" placeholder="Es. In corso / Terminata">

    <label>Note</label>
    <textarea id="r_note"></textarea>

    <button id="saveRiproduzione" class="success">Salva</button>
    <button id="cancelRiproduzione" class="secondary">Annulla</button>
  </div>

  <div id="listaRiproduzione"></div>
</section>

<section id="genealogia" class="hidden">
  <h2>🌳 Genealogia</h2>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>
  <div class="card">
    <p>Cerca un soggetto per visualizzare padre, madre, fratelli/sorelle e discendenza.</p>
    <label>Cerca soggetto</label><input id="cercaGenealogia" placeholder="Nome, codice o anellino">
    <div id="risultatoGenealogia"></div>
  </div>
</section>

<section id="gabbie" class="hidden">
  <div class="page-title"><h2>🏠 Gabbie</h2><button id="newGabbia">+ Nuova gabbia</button></div>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>
  <div id="formGabbia" class="card hidden">
    <label>Numero</label><input id="g_numero" placeholder="Es. 01">
    <label>Posizione</label><input id="g_posizione">
    <label>Tipo</label><input id="g_tipo" placeholder="Es. Cova / Voliera">
    <label>Capacità</label><input id="g_capacita" type="number" min="0">
    <label>Capacità soggetti</label><input id="g_capacita_soggetti" type="number" min="0">
    <label>Coppia</label><input id="g_coppia_soggetti" placeholder="Es. CP 1">
    <label>Stato</label><input id="g_stato" placeholder="Es. Libera / Occupata">
    <label>Note</label><textarea id="g_note"></textarea>
    <button id="saveGabbia" class="success">Salva gabbia</button><button id="cancelGabbia" class="secondary">Annulla</button>
  </div>
  <div id="listaGabbie"></div>
</section>

<section id="alimentazione" class="hidden">
  <div class="page-title"><h2>🌾 Alimentazione</h2><button id="newAlimentazione">+ Nuovo alimento</button></div>
  <button class="secondary back" data-page="home">← Torna alla schermata principale</button>
  <div id="formAlimentazione" class="card hidden">
  <label>Data</label>
  <input id="a_data" type="date">

  <label>Alimento</label>
  <input id="a_alimento" placeholder="Es. Miscela semi">

  <label>Fase</label>
  <select id="a_fase">
    <option value="">Seleziona fase</option>
    <option value="RIPRODUZIONE">RIPRODUZIONE</option>
    <option value="MUTA">MUTA</option>
    <option value="MANTENIMENTO">MANTENIMENTO</option>
    <option value="RIPOSO">RIPOSO</option>
