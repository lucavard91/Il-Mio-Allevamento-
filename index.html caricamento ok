  toggle("loginScreen",false);
  toggle("resetScreen",false);
  toggle("recoverAccountScreen",true);
  const email=$("loginEmail")?.value||"";
  const campo=$("recoverAccountEmail");
  if(campo){
    campo.value=email;
    setTimeout(()=>campo.focus(),100);
  }
}
function chiudiRecuperaAccount(){
  toggle("recoverAccountScreen",false);
  toggle("loginScreen",true);
  toggle("resetScreen",false);
  $("recoverAccountMessage").textContent="";
}
async function inviaRecuperaAccount(){
  const email=valore("recoverAccountEmail");
  if(!email){
    $("recoverAccountMessage").textContent=
      "Inserisci un indirizzo email.";
    return;
  }
  const box=$("recoverAccountMessage");
  try{
    box.textContent="Invio della richiesta in corso...";
    const redirectTo=
      window.location.origin+
      window.location.pathname;
    const {error}=await sb.auth.resetPasswordForEmail(
      email,
      {redirectTo}
    );
    if(error)throw error;
    box.textContent=
      "Se l'indirizzo è associato a un account, "+
      "riceverai un'email per recuperare l'accesso.";
  }catch(e){
    console.error(e);
    box.textContent=
      "Se l'indirizzo è associato a un account, "+
      "riceverai un'email per recuperare l'accesso.";
  }
}
async function mostraRecupero(){
  const email=valore("loginEmail");
  if(!email){msg("Inserisci prima la tua email, poi tocca Password dimenticata.");return;}
  try{
    const redirectTo=window.location.origin+window.location.pathname;
    const {error}=await sb.auth.resetPasswordForEmail(email,{redirectTo});
    if(error){msg(error.message);return;}
    msg("Se l'indirizzo è registrato, riceverai un'email per reimpostare la password.",true);
  }catch(e){msg(e?.message||e);}
}

async function aggiornaPassword(){
  const p=$("newPassword").value,c=$("newPasswordConfirm").value;
  if(!p||p.length<6){resetMsg("La password deve contenere almeno 6 caratteri.");return;}
  if(p!==c){resetMsg("Le due password non coincidono.");return;}
  try{
    const {error}=await sb.auth.updateUser({password:p});
    if(error){resetMsg(error.message);return;}
    resetMsg("Password aggiornata. Ora puoi accedere con la nuova password.",true);
    setTimeout(()=>{toggle("resetScreen",false);toggle("loginScreen",true);},1500);
  }catch(e){resetMsg(e?.message||e);}
}

async function logout(){await sb.auth.signOut();location.reload();}

async function avviaMostraApp(sessionOverride=null){
  if(mostraAppPromise)return mostraAppPromise;
  if(sessionOverride?.user){
    sessionUser=sessionOverride.user;
  }else if(!sessionUser?.id){
    try{
      const {data}=await sb.auth.getSession();
      if(!data?.session?.user)return;
      sessionUser=data.session.user;
    }catch(e){return;}
  }
  mostraAppPromise=mostraApp().finally(()=>{mostraAppPromise=null;});
  return mostraAppPromise;
}

