async function caricaFotoSoggetto(soggettoId,file){
  const u=await utenteCorrente();
  if(!file.type.startsWith("image/"))throw new Error("Seleziona un file immagine.");
  const ext=(file.name.split(".").pop()||"jpg").toLowerCase().replace(/[^a-z0-9]/g,"")||"jpg";
  const path=`${u.id}/${allevamentoAttivo.id}/${soggettoId}-${Date.now()}.${ext}`;
  const up=await sb.storage.from("myagari-fot").upload(path,file,{upsert:true,contentType:file.type});
  if(up.error)throw up.error;
  const {data:pub}=sb.storage.from("myagari-fot").getPublicUrl(path);
  const {error}=await sb.from("soggetti").update({foto_url:pub.publicUrl}).eq("id",soggettoId).eq("allevamento_id",allevamentoAttivo.id);
  if(error)throw error;
  return pub.publicUrl;
}

async function caricaFotoDaScheda(id){
  const input=document.createElement("input");input.type="file";input.accept="image/*";
  input.onchange=async()=>{try{const f=input.files?.[0];if(!f)return;await caricaFotoSoggetto(id,f);await aggiornaSoggetti();alert("📷 Foto caricata correttamente.");}catch(e){errore(e);}};
  input.click();
}

