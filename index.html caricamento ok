async function eseguiValutazioneAI(id){
  const endpoint=(window.MYAGARI_AI_ENDPOINT||"").trim();

  if(!endpoint){
    alert(
      "La schermata AI è pronta, ma il motore AI non è ancora collegato. "+
      "Per sicurezza il collegamento dovrà avvenire tramite un servizio "+
      "server-side, senza chiavi API nel file index.html."
    );
    return;
  }

  const root=$("aiResult");

  if(root){
    root.innerHTML='<p>🤖 Analisi in corso…</p>';
  }

  try{
    const dati=await leggi("soggetti");
    const s=dati.find(x=>String(x.id)===String(id));

    if(!s){
      throw new Error("Soggetto non trovato.");
    }

    const u=await utenteCorrente();

    if(!u){
      throw new Error("Utente non autenticato.");
    }

    const res=await fetch(endpoint,{
      method:"POST",
      headers:{
        "Content-Type":"application/json"
      },
      body:JSON.stringify({
        soggetto:s,
        standardFonte:"FOI",
        foto_url:s?.foto_url||null
      })
    });

    if(!res.ok){
      throw new Error(
        "Servizio AI non disponibile (HTTP "+res.status+")"
      );
    }

    const result=await res.json();

    const score=Number(
      result.punteggio??result.score
    );

    const puntiForza=
      result.punti_forza||
      result.strengths||
      [];

    const daMigliorare=
      result.da_migliorare||
      result.improvements||
      [];

    const analisi=
      result.analisi||
      result.analysis||
      "";

    const record={
      user_id:u.id,
      soggetto_id:id,
      punteggio:Number.isFinite(score)?score:null,
      punti_forza:Array.isArray(puntiForza)
        ? puntiForza
        : [],
      da_migliorare:Array.isArray(daMigliorare)
        ? daMigliorare
        : [],
      analisi:String(analisi||"")
    };

    const {error}=await sb
      .from("valutazioni_ai")
      .insert(record);

    if(error){
      throw error;
    }

    renderRisultatoAI(id,result);

  }catch(e){

    if(root){
      root.innerHTML=
        '<div class="error">'+
        'Errore valutazione AI: '+
        esc(e.message||e)+
        '</div>';
    }

    console.error(e);
  }
}


function renderRisultatoAI(id,r){

  const root=$("aiResult");

  if(!root)return;

  const score=Number(
    r.punteggio??r.score
  );

  const puntiForza=
    r.punti_forza||
    r.strengths||
    [];

  const daMigliorare=
    r.da_migliorare||
    r.improvements||
    [];

  if(Number.isFinite(score)){

    const scores=JSON.parse(
      localStorage.getItem("myagari_ai_scores")||"{}"
    );

    scores[String(id)]={
      score:score,
      updated_at:new Date().toISOString()
    };

    localStorage.setItem(
      "myagari_ai_scores",
      JSON.stringify(scores)
    );
  }

  root.innerHTML=`

    <h3>📊 Valutazione AI</h3>

    <div class="ai-punteggio">
      ${Number.isFinite(score)
        ? score.toFixed(1)
        : "—"} / 100
    </div>

    <p><b>Punti di forza</b></p>

    <ul>
      ${
        (Array.isArray(puntiForza)
          ? puntiForza
          : []
        )
        .map(x=>`<li>${esc(x)}</li>`)
        .join("")
        ||
        "<li>Non disponibili</li>"
      }
    </ul>

    <p><b>Da migliorare</b></p>

    <ul>
      ${
        (Array.isArray(daMigliorare)
          ? daMigliorare
          : []
        )
        .map(x=>`<li>${esc(x)}</li>`)
        .join("")
        ||
        "<li>Non disponibili</li>"
      }
    </ul>

    <p class="small">
      Il risultato mostrato è un'analisi assistita e non sostituisce
      il giudizio ufficiale di un giudice FOI.
      La valutazione è stata salvata nell'archivio dell'allevamento.
    </p>

  `;
}
