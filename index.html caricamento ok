  msg("Accesso in corso...",true);
  try{
    const {data,error}=await sb.auth.signInWithPassword({email,password});
    if(error){msg(error.message);return;}
    sessionUser=data?.session?.user||sessionUser;
    await caricaProfilo();
    if(profilo.ruolo!=="admin" && !accessoValido()){
      const pending=!profilo.attivo && !profilo.scadenza;
      await sb.auth.signOut();
      msg(pending
        ? "⏳ Account creato correttamente ma ancora in attesa di approvazione dell'amministratore."
