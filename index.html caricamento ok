async function caricaCriteriFOI(specie,categoriaFOI="",criterio=""){
  const box=$("risultatoStandardFOI"); if(!box)return;
  const nomeSpecie=(specie||"").trim();
  if(!nomeSpecie){box.innerHTML='<div class="card"><p>Seleziona una specie per caricare lo standard.</p></div>';return;}
  box.innerHTML='<div class="card"><p>⏳ Caricamento criteri FOI...</p></div>';
  try{
    const {data,error}=await sb.from("foi_fpl_criteri")
      .select("id,razza,criterio,descrizione,punteggio_max,penalizzazione,versione_standard,data_aggiornamento,fonte,classificazione_id")
      .ilike("razza",nomeSpecie)
      .order("id",{ascending:true});
    if(error)throw error;
    const tutti=(data||[]);
    if(!tutti.length){box.innerHTML='<div class="card"><h3>⚠️ Nessun criterio trovato</h3><p>Non risultano criteri FOI disponibili per <b>'+esc(nomeSpecie)+'</b> nel database dell&#39;app.</p><p class="small">La specie e la varietà sono state riconosciute dall&#39;interfaccia, ma per questa specie non è ancora presente uno standard nella tabella dei criteri.</p></div>';return;}
    const criteri=[...new Set(tutti.map(c=>(c.criterio||"").trim()).filter(Boolean))];
    const sel=$("foiCriterio");
    if(sel){
      sel.innerHTML='<option value="">— Tutti i criteri —</option>'+criteri.map(c=>'<option value="'+esc(c)+'">'+esc(c)+'</option>').join("");
      if(criterio && criteri.includes(criterio))sel.value=criterio;
    }
    const filtrati=criterio?tutti.filter(c=>(c.criterio||"").trim()===criterio):tutti;
    const versioni=[...new Set(filtrati.map(c=>c.versione_standard).filter(Boolean))];
    const righe=filtrati.map((c,i)=>{
      const max=(c.punteggio_max!==null&&c.punteggio_max!==undefined)?Number(c.punteggio_max):null;
      return '<div class="card foi-criterio"><div class="page-title"><h3>'+esc(c.criterio||('Criterio '+(i+1)))+'</h3>'+(max!==null&&!Number.isNaN(max)?'<strong>Max '+esc(String(max))+' pt</strong>':'')+'</div>'+
        (c.descrizione?'<p>'+esc(c.descrizione)+'</p>':'')+
        (c.penalizzazione?'<p><b>Difetti / penalizzazioni:</b> '+esc(c.penalizzazione)+'</p>':'')+
        '<label>Punteggio assegnato'+(max!==null&&!Number.isNaN(max)?' (0–'+esc(String(max))+')':'')+'</label>'+ 
        '<input class="foi-punteggio" type="number" min="0" '+(max!==null&&!Number.isNaN(max)?'max="'+esc(String(max))+'" ':'')+'step="0.5" inputmode="decimal" data-criterio-id="'+esc(String(c.id))+'" data-max="'+(max!==null&&!Number.isNaN(max)?esc(String(max)):'' )+'" placeholder="Inserisci punteggio">'+
        '<p class="small">'+(c.data_aggiornamento?'<b>Aggiornamento:</b> '+esc(String(c.data_aggiornamento))+' · ':'')+(c.fonte?'<b>Fonte:</b> '+esc(c.fonte):'')+'</p></div>';
    }).join('');
    const mutazione=$("foiMutazione")?.value?.trim()||"";
    const categoriaVisuale=categoriaFOI||"";
    box.innerHTML='<div class="card"><h3>🏆 '+esc(nomeSpecie)+(mutazione?' — '+esc(mutazione):'')+'</h3><p class="small">'+(categoriaVisuale?'Categoria FOI: <b>'+esc(categoriaVisuale)+'</b> · ':'')+'Criteri disponibili: <b>'+tutti.length+'</b>'+(versioni.length?' · Standard: '+esc(versioni.join(', ')):'')+'</p><p>Puoi consultare tutti i criteri oppure selezionarne uno. Se hai scelto un soggetto, puoi anche assegnare i punteggi e salvarli.</p><div class="page-title"><strong>Totale: <span id="foiTotale">0</span> pt</strong><strong>Valutati: <span id="foiValutati">0</span>/'+filtrati.length+'</strong></div><button id="salvaValutazioneFOI" class="success" type="button">💾 Salva valutazione</button><div id="foiSalvataggioMessaggio" class="small"></div></div>'+righe;
    box.querySelectorAll('.foi-punteggio').forEach(input=>input.addEventListener('input',aggiornaTotaleFOI));
    const btn=$("salvaValutazioneFOI"); if(btn)btn.onclick=()=>salvaValutazioneFOI(filtrati,nomeSpecie,versioni);
    aggiornaTotaleFOI();
  }catch(e){console.error(e);box.innerHTML='<div class="card"><h3>❌ Errore caricamento standard FOI</h3><p>'+esc(e?.message||e)+'</p><p class="small">È stata eseguita solo una lettura: nessun dato è stato modificato.</p></div>';}
}

function aggiornaTotaleFOI(){
  const inputs=document.querySelectorAll('#risultatoStandardFOI .foi-punteggio');
  let totale=0,valutati=0;
  inputs.forEach(i=>{if(i.value!==""){const n=Number(i.value);if(Number.isFinite(n)){totale+=n;valutati++;}}});
  const t=$("foiTotale"),v=$("foiValutati"); if(t)t.textContent=totale.toFixed(2).replace(/\\.00$/,''); if(v)v.textContent=String(valutati);
}

async function salvaValutazioneFOI(criteri,nomeRazza,versioni){
  const msgBox=$("foiSalvataggioMessaggio"),btn=$("salvaValutazioneFOI");
  const soggettoId=valore("foiSoggetto");
  if(!soggettoId){if(msgBox)msgBox.textContent="⚠️ Seleziona prima un soggetto dell'allevamento.";return;}
  const inputs=[...document.querySelectorAll('#risultatoStandardFOI .foi-punteggio')];
  const dettagli=[]; let totale=0;
  for(const input of inputs){
    const raw=input.value.trim();
    if(raw===""){if(msgBox)msgBox.textContent="⚠️ Inserisci un punteggio per ogni criterio prima di salvare.";return;}
    const punti=Number(raw),max=input.dataset.max===""?null:Number(input.dataset.max);
    if(!Number.isFinite(punti)||punti<0||(max!==null&&Number.isFinite(max)&&punti>max)){
      if(msgBox)msgBox.textContent="⚠️ Controlla i punteggi: devono essere numerici e non superiori al massimo previsto.";return;
    }
    totale+=punti;
    dettagli.push({criterio_id:Number(input.dataset.criterioId),punti_ottenuti:punti,note:null});
  }
  try{
    if(btn)btn.disabled=true;
    if(msgBox)msgBox.textContent="⏳ Salvataggio in corso...";
    let classificazioneId=criteri.find(c=>c.classificazione_id)?.classificazione_id||null;
    if(!classificazioneId){
      const {data:cl,error:ce}=await sb.from("foi_classificazioni").select("id").ilike("razza",nomeRazza).limit(1);
      if(ce)throw ce;
      classificazioneId=cl?.[0]?.id||null;
    }
    if(!classificazioneId)throw new Error("Non è stata trovata una classificazione FOI associata alla razza.");
    const {data:stds,error:se}=await sb.from("foi_standard").select("id,versione_id,nome").eq("classificazione_id",classificazioneId).eq("attivo",true).order("id",{ascending:false}).limit(1);
    if(se)throw se;
    const standard=stds?.[0];
    if(!standard)throw new Error("Non è stato trovato uno standard FOI attivo per questa classificazione.");
    const {data:val,error:ve}=await sb.from("foi_valutazioni").insert({soggetto_id:soggettoId,standard_id:standard.id,versione_id:standard.versione_id,punteggio_totale:totale,note:null,allevamento_id:allevamentoAttivo.id}).select("id").single();
    if(ve)throw ve;
    const {error:de}=await sb.from("foi_valutazioni_dettagli").insert(dettagli.map(d=>({...d,valutazione_id:val.id})));
    if(de){await sb.from("foi_valutazioni").delete().eq("id",val.id);throw de;}
    if(msgBox)msgBox.textContent="✅ Valutazione salvata correttamente (ID "+val.id+") — Totale: "+totale+" pt.";
  }catch(e){console.error(e);if(msgBox)msgBox.textContent="❌ Errore salvataggio: "+(e?.message||e);}
  finally{if(btn)btn.disabled=false;}
}

async function inizializzaStandardFOI(){
  const specieInput=$("foiSpecie"),mutInput=$("foiMutazione");
  if(!specieInput||specieInput.dataset.initialized==="1")return;
  specieInput.dataset.initialized="1";
  const catalogo=(typeof CATALOGO_FOI!=="undefined")?CATALOGO_FOI:null;
  const specie=[...new Set(catalogo?Object.values(catalogo.categorie).flat():[])].sort((a,b)=>a.localeCompare(b,'it'));
  const categoriaPerSpecie=s=>catalogo?Object.entries(catalogo.categorie).find(([cat,arr])=>arr.some(x=>x.toLowerCase()===s.toLowerCase()))?.[0]||"":"";
  const mutazioniPerSpecie=s=>{if(!catalogo)return[];const key=Object.keys(catalogo.mutazioni||{}).find(k=>k.toLowerCase()===s.toLowerCase());return key?(catalogo.mutazioni[key]||[]):[];};
  const setup=(input,box,getData,onPick)=>{
    if(!input||!box)return;
    input.addEventListener("input",()=>{const testo=input.value.trim().toLowerCase();const dati=getData();const risultati=(testo?dati.filter(x=>x.toLowerCase().includes(testo)):dati).slice(0,40);box.innerHTML=risultati.map(x=>'<div class="suggerimento-item">'+esc(x)+'</div>').join('');box.style.display=risultati.length?'block':'none';box.querySelectorAll('.suggerimento-item').forEach(item=>item.addEventListener('click',()=>{input.value=item.textContent;box.innerHTML='';box.style.display='none';if(onPick)onPick(item.textContent);}));});
    input.addEventListener("blur",()=>setTimeout(()=>{box.innerHTML='';box.style.display='none';},180));
  };
  const aggiornaCategoria=()=>{const s=specieInput.value.trim();const cat=categoriaPerSpecie(s);const sel=$("foiCategoriaFOI");if(sel)sel.innerHTML=cat?'<option value="'+esc(cat)+'">'+esc(cat)+'</option>':'<option value="">— Seleziona prima la specie —</option>';if(mutInput){const ms=mutazioniPerSpecie(s);if(s&&!ms.includes(mutInput.value.trim()))mutInput.value="";}};
  setup(specieInput,$("foiSuggerimentiSpecie"),()=>specie,()=>{aggiornaCategoria();});
  setup(mutInput,$("foiSuggerimentiMutazione"),()=>mutazioniPerSpecie(specieInput.value.trim()),()=>{});
  specieInput.addEventListener("change",aggiornaCategoria);specieInput.addEventListener("blur",()=>setTimeout(aggiornaCategoria,200));
  await caricaSoggettiPerFOI();
}

async function caricaSoggettiPerFOI(){
  const select=$("foiSoggetto"); if(!select||select.dataset.initialized==="1")return; select.dataset.initialized="1";
  try{
    const {data,error}=await sb.from("soggetti").select("id,anno,numero,nome,razza,sesso,mutazione").eq("allevamento_id",allevamentoAttivo.id).order("anno",{ascending:false}).order("numero",{ascending:true});
    if(error)throw error;
    const soggetti=data||[];
    select.innerHTML='<option value="">— Seleziona un soggetto —</option>'+soggetti.map(s=>{const etichetta=[s.anno,s.numero].filter(v=>v!==null&&v!==undefined&&String(v)!=="").join(" / ")||s.nome||"Soggetto";const extra=[s.nome,s.sesso,s.razza,s.mutazione].filter(Boolean).join(" · ");return '<option value="'+esc(String(s.id))+'" data-specie="'+esc(s.razza||"")+'" data-mutazione="'+esc(s.mutazione||"")+'">'+esc(etichetta+(extra?' — '+extra:''))+'</option>';}).join('');
    select.addEventListener("change",()=>{const opt=select.options[select.selectedIndex];const specie=opt?.dataset?.specie||"";const mut=opt?.dataset?.mutazione||"";if(specie){$("foiSpecie").value=specie;const cat=(typeof CATALOGO_FOI!=="undefined")?Object.entries(CATALOGO_FOI.categorie).find(([cat,arr])=>arr.some(x=>x.toLowerCase()===specie.toLowerCase()))?.[0]||"":"";const sel=$("foiCategoriaFOI");if(sel)sel.innerHTML=cat?'<option value="'+esc(cat)+'">'+esc(cat)+'</option>':'<option value="">— Categoria non determinata —</option>';}if(mut)$("foiMutazione").value=mut;});
  }catch(e){console.warn("Impossibile caricare i soggetti per lo standard FOI",e);}
}

async function caricaSoggettiPerFOI(){
  const select=$("foiSoggetto"); if(!select||select.dataset.initialized==="1")return; select.dataset.initialized="1";
  try{
    const {data,error}=await sb.from("soggetti").select("id,anno,numero,nome,razza,sesso").eq("allevamento_id",allevamentoAttivo.id).order("anno",{ascending:false}).order("numero",{ascending:true});
    if(error)throw error;
    const soggetti=data||[];
    select.innerHTML='<option value="">— Seleziona un soggetto —</option>'+soggetti.map(s=>{
      const etichetta=[s.anno,s.numero].filter(v=>v!==null&&v!==undefined&&String(v)!=="").join(" / ") || s.nome || "Soggetto";
      const extra=[s.nome,s.sesso,s.razza].filter(Boolean).join(" · ");
