      return;
    }
    await avviaMostraApp();
  }catch(e){msg("Errore durante l'accesso: "+(e?.message||e));}
}

async function registratiSupabase(){
  const email=valore("loginEmail"),password=$("loginPassword").value;
  if(!email||!password){
    msg("Inserisci email e password.");
    return;
  }
  try{
    msg("Verifica account in corso...",true);
    const {data,error}=await sb.auth.signUp({
      email,
      password
    });
    if(error){
      const testo=(error.message||"").toLowerCase();
      if(
        testo.includes("already") ||
        testo.includes("registered") ||
        testo.includes("exists") ||
        testo.includes("user already")
      ){
        msg(
          "Se questo indirizzo è già associato a un account, " +
          "non è necessario crearne uno nuovo. " +
          "Prova ad accedere oppure usa \"Password dimenticata?\"."
        );
        return;
      }
      msg("Impossibile creare l'account. Riprova oppure usa \"Password dimenticata?\".");
      console.error(error);
      return;
    }
    if(data?.session){
      await caricaProfilo();
      await sb.auth.signOut();
      msg("✅ Registrazione completata. Il tuo account è in attesa di approvazione da parte dell'amministratore. Riceverai l'accesso dopo l'approvazione.",true);
      return;
    }
    msg(
      "Se l'indirizzo è già associato a un account, " +
      "puoi accedere oppure recuperare l'accesso con \"Password dimenticata?\". " +
      "Altrimenti controlla la tua email per confermare il nuovo account.",
      true
    );
  }catch(e){
    console.error(e);
    msg(
      "Non è stato possibile completare la registrazione. " +
      "Puoi provare ad accedere oppure recuperare l'accesso."
    );
  }
}
